# Copie para .env na raiz e ajuste os valores.
# A API também lê apps/api/.env — use um dos dois (ou ambos iguais).

# --- Desenvolvimento local (docker compose up = Postgres só deste app) ---
POSTGRES_PORT=5436
MUCIFRAR_DB_PASSWORD=mucifrar_secret
DATABASE_URL=postgresql://mucifrar:mucifrar_secret@127.0.0.1:5436/mucifrar

API_PORT=3003
JWT_SECRET=altere-este-segredo-em-producao-min-16
JWT_REFRESH_SECRET=altere-este-refresh-secret-prod
CORS_ORIGIN=http://localhost:5178
APP_URL=http://localhost:5178
NODE_ENV=development

RATE_LIMIT_API_MAX=1000
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_PUBLIC_MAX=120

VITE_API_URL=

# --- Produção (docker-compose.prod.yml + rede netsys) ---
# 1) Infra: cd ../docker-config && ./scripts/up.sh && ./scripts/ensure-app-dbs.sh
# 2) Defina MUCIFRAR_DB_PASSWORD igual ao de docker-config/.env
# 3) Troque secrets JWT (mín. 16 chars, sem "altere-" / "dev-")
# 4) Suba: npm run docker:prod
#
# WEB_PORT=8095
# NODE_ENV=production
# DATABASE_URL=postgresql://mucifrar:SENHA@postgres:5432/mucifrar
# CORS_ORIGIN=https://seu-dominio
# APP_URL=https://seu-dominio
# JWT_SECRET=
# JWT_REFRESH_SECRET=
