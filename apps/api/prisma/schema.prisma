generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum CifraStatus {
  DRAFT
  PUBLISHED
}

enum PlaylistVisibility {
  PUBLIC
  PRIVATE
}

model User {
  id                 String     @id @default(cuid())
  name               String
  email              String     @unique
  passwordHash       String
  role               UserRole   @default(USER)
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(false)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  cifras              Cifra[]
  cifraPreferences    CifraPreference[]
  playlists           Playlist[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Cifra {
  id        String      @id @default(cuid())
  slug      String      @unique
  title     String
  artist    String
  key       String      @default("C")
  content   String      @db.Text
  status    CifraStatus @default(DRAFT)
  views     Int         @default(0)
  authorId  String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  author      User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  preferences CifraPreference[]
  playlistItems PlaylistItem[]

  @@index([status, title])
  @@index([artist])
  @@index([authorId])
  @@map("cifras")
}

model CifraPreference {
  id        String   @id @default(cuid())
  userId    String
  cifraId   String
  semitones Int      @default(0)
  capo      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  cifra Cifra @relation(fields: [cifraId], references: [id], onDelete: Cascade)

  @@unique([userId, cifraId])
  @@index([userId])
  @@map("cifra_preferences")
}

model Playlist {
  id          String             @id @default(cuid())
  slug        String             @unique
  title       String
  description String?            @db.VarChar(500)
  visibility  PlaylistVisibility @default(PRIVATE)
  ownerId     String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  owner User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items PlaylistItem[]

  @@index([visibility, title])
  @@index([ownerId])
  @@map("playlists")
}

model PlaylistItem {
  id         String   @id @default(cuid())
  playlistId String
  cifraId    String
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  cifra    Cifra    @relation(fields: [cifraId], references: [id], onDelete: Cascade)

  @@unique([playlistId, cifraId])
  @@index([playlistId, position])
  @@index([cifraId])
  @@map("playlist_items")
}
